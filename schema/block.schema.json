{
  "$id": "https://quizloop.dev/schema/block.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "blockId": {
      "type": "string",
      "pattern": "^\\d{4}$"
    },
    "questions": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "conceptId": {
            "type": "string",
            "minLength": 1
          },
          "stem": {
            "type": "object",
            "properties": {
              "md": {
                "type": "string",
                "minLength": 1
              },
              "imageRef": {
                "type": "string",
                "pattern": "^assets\\/(img|tbl)\\/[\\w.-]+\\.(webp|png|svg)$"
              }
            },
            "required": [
              "md"
            ]
          },
          "choices": {
            "minItems": 2,
            "maxItems": 5,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string",
                  "enum": [
                    "A",
                    "B",
                    "C",
                    "D",
                    "E"
                  ]
                },
                "md": {
                  "type": "string",
                  "minLength": 1
                },
                "imageRef": {
                  "type": "string",
                  "pattern": "^assets\\/(img|tbl)\\/[\\w.-]+\\.(webp|png|svg)$"
                }
              },
              "required": [
                "key",
                "md"
              ]
            }
          },
          "correct": {
            "type": "string",
            "enum": [
              "A",
              "B",
              "C",
              "D",
              "E"
            ]
          },
          "distractors": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "enum": [
                "A",
                "B",
                "C",
                "D",
                "E"
              ]
            },
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          },
          "solution": {
            "minItems": 1,
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "text"
                    },
                    "md": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "type",
                    "md"
                  ]
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "hint"
                    },
                    "md": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "type",
                    "md"
                  ]
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "formula"
                    },
                    "tex": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "type",
                    "tex"
                  ]
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "image"
                    },
                    "ref": {
                      "type": "string",
                      "pattern": "^assets\\/(img|tbl)\\/[\\w.-]+\\.(webp|png|svg)$"
                    },
                    "caption": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "type",
                    "ref"
                  ]
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "table"
                    },
                    "header": {
                      "minItems": 1,
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "rows": {
                      "minItems": 1,
                      "type": "array",
                      "items": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    },
                    "caption": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "type",
                    "header",
                    "rows"
                  ]
                }
              ]
            }
          },
          "source": {
            "type": "object",
            "properties": {
              "file": {
                "type": "string",
                "minLength": 1
              },
              "pages": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  }
                ],
                "items": false,
                "minItems": 2,
                "maxItems": 2
              },
              "quote": {
                "type": "string",
                "minLength": 1
              },
              "chapter": {
                "type": "string"
              }
            },
            "required": [
              "file",
              "pages",
              "quote"
            ]
          },
          "difficulty": {
            "type": "string",
            "enum": [
              "kolay",
              "orta",
              "zor"
            ]
          },
          "tags": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "contentHash": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64
          },
          "deleted": {
            "default": false,
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "conceptId",
          "stem",
          "choices",
          "correct",
          "distractors",
          "solution",
          "source",
          "difficulty",
          "contentHash"
        ]
      }
    }
  },
  "required": [
    "blockId",
    "questions"
  ]
}
