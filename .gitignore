node_modules/
dist/
dist-electron/
release/
out/
.vite/
*.log
.DS_Store
Thumbs.db
.env
.env.*
!.env.example

# Content modules never ship with the engine.
modules/*

# Local caches produced while building modules.
.quizloop-cache/
sources/**/pages.jsonl
sources/**/build/

# Real source data (rules, chapter maps, build state) never enters git.
# Only the neutral template under sources/example/ is tracked.
sources/*
!sources/example/

# Local agent/relay working state.
.claude/relay/
.claude/agent-memory/

# Raw source books (copyrighted, hundreds of MB) never enter git.
database/

# Lint cache.
.eslintcache
trash/
__pycache__/

tmp/

*.tsbuildinfo

tools/bildirim/.dev.vars
tools/bildirim/.wrangler/

# Requests from module sessions stay local; only the guide and template are tracked.
docs/iskelet-talepleri/*
!docs/iskelet-talepleri/AGENTS.md
!docs/iskelet-talepleri/CLAUDE.md
!docs/iskelet-talepleri/_sablon.md
OrijinalSorular/
