{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "src/renderer/src/env.d.ts",
    "src/renderer/src/**/*",
    "src/renderer/src/**/*.tsx",
    "teknesyum-ui/ustcubuk/*.tsx",
    "src/preload/*.d.ts",
    "src/android/**/*",
    "src/core/**/*",
    "src/shared/**/*",
    "locale/*.json"
  ],
  "exclude": ["src/core/**/*.test.ts"],
  "compilerOptions": {
    "composite": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@renderer/*": ["src/renderer/src/*"],
      "@core/*": ["src/core/*"],
      "@shared/*": ["src/shared/*"],
      "@locale/*": ["locale/*"]
    }
  }
}
